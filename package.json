{
  "name": "restream-mcp-http",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Restream API MCP with broker-first authentication",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/http.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --write src test scripts README.md package.json tsconfig.json",
    "lint": "prettier --check src test scripts README.md package.json tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
