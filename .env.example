BROKER_BASE_URL=https://connectionsbroker.agenticledger.ai
BROKER_CLIENT_NAMESPACE=restream-mcp-prod
BROKER_INSTALL_BEARER=
BROKER_JWT_KEY=
# Local stdio only: stable operator principal, never a hosted fallback.
RESTREAM_PRINCIPAL=
RESTREAM_MOCK=false
RESTREAM_ENABLE_WRITES=false
# Hosted gateway principal headers require HMAC signatures. Standalone callers use a private random Bearer identity.
BROKER_PRINCIPAL_HMAC_KEY=
RESTREAM_ALLOW_DIRECT_TOKEN=false
PORT=3100
HOST=127.0.0.1
ALLOWED_ORIGINS=
